---
// Layout de las páginas SEO del catálogo: /repuestos/, /repuestos/<cat>/, /repuestos/<cat>/<marca>/, /marcas/<marca>/
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProductoLista from '../components/ProductoLista.astro';
import ListadoGrupos from '../components/ListadoGrupos.astro';

interface Enlace { label: string; url: string; total?: number; activo?: boolean }
interface Props {
  titulo: string;
  descripcion: string;
  h1: string;
  intro: string;
  migas: { nombre: string; url: string }[];
  grupos?: { titulo: string; enlaces: Enlace[] }[];
  tituloProductos?: string;
  productos?: any[];
  pagina?: { actual: number; total: number; anterior?: string; siguiente?: string; base: string };
  verTodos?: { label: string; url: string };
  /** true: los productos van arriba y los links a otras secciones abajo */
  productosPrimero?: boolean;
}
const { titulo, descripcion, h1, intro, migas, grupos = [], tituloProductos, productos = [], pagina, verTodos, productosPrimero = false } = Astro.props;

const site = Astro.site!;
const schemaMigas = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: migas.map((m, i) => ({ '@type': 'ListItem', position: i + 1, name: m.nombre, item: new URL(m.url, site).href })),
};
const urlPagina = (n: number) => (n === 1 ? pagina!.base : `${pagina!.base}${n}/`);
---
<Base titulo={titulo} descripcion={descripcion}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schemaMigas)} />
    {pagina?.anterior && <link rel="prev" href={new URL(pagina.anterior, site).href} />}
    {pagina?.siguiente && <link rel="next" href={new URL(pagina.siguiente, site).href} />}
  </Fragment>
  <Header />
  <main class="lst-main">
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <symbol id="ico-wa" viewBox="0 0 24 24"><path fill="currentColor" d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></symbol>
    </svg>

    <nav class="lst-migas" aria-label="Estás en">
      {migas.map((m, i) => (
        i < migas.length - 1
          ? <><a href={m.url}>{m.nombre}</a><span aria-hidden="true">›</span></>
          : <span aria-current="page">{m.nombre}</span>
      ))}
    </nav>

    <header class="lst-head">
      <h1>{h1}</h1>
      <p>{intro}</p>
    </header>

    {!productosPrimero && <ListadoGrupos grupos={grupos} />}

    {productos.length > 0 && (
      <section class="lst-productos">
        {tituloProductos && <h2>{tituloProductos}</h2>}
        <div class="lst-grid">
          {productos.map((p) => <ProductoLista p={p} />)}
        </div>
      </section>
    )}

    {pagina && pagina.total > 1 && (
      <nav class="lst-paginas" aria-label="Páginas">
        {pagina.anterior && <a href={pagina.anterior} rel="prev">← Anterior</a>}
        {Array.from({ length: pagina.total }, (_, i) => i + 1).map((n) => (
          n === pagina.actual
            ? <span aria-current="page">{n}</span>
            : <a href={urlPagina(n)}>{n}</a>
        ))}
        {pagina.siguiente && <a href={pagina.siguiente} rel="next">Siguiente →</a>}
      </nav>
    )}

    {productosPrimero && <div class="lst-abajo"><ListadoGrupos grupos={grupos} /></div>}

    {verTodos && (
      <p class="lst-ver-todos"><a href={verTodos.url}>{verTodos.label} →</a></p>
    )}

    <aside class="lst-ayuda">
      <p><strong>¿No encontrás el repuesto o no sabés si le va a tu auto?</strong> Usá el buscador del catálogo o respondé unas preguntas y te ayudamos.</p>
      <div class="lst-ayuda-acciones">
        <a href="/catalogo/" class="lst-btn">Buscar en el catálogo</a>
        <button type="button" class="lst-btn lst-btn-sec" data-abrir-asistente>Abrir el asistente</button>
      </div>
    </aside>
  </main>
  <Footer />
</Base>
<style>
  .lst-main { max-width: 1180px; margin: 0 auto; padding: var(--esp-6) var(--esp-4) var(--esp-8); }
  .lst-migas { display: flex; flex-wrap: wrap; gap: 6px; font-size: var(--texto-sm); color: var(--color-texto-terciario); margin-bottom: var(--esp-5); }
  .lst-migas a { color: var(--color-texto-secundario); }
  .lst-migas a:hover { color: var(--color-marca-texto); }
  .lst-head h1 { font-size: var(--texto-display); margin: 0 0 var(--esp-2); }
  .lst-head p { color: var(--color-texto-secundario); max-width: 70ch; margin: 0 0 var(--esp-8); }
  .lst-abajo { margin-top: var(--esp-12); }
  .lst-productos h2 { font-size: var(--texto-h3); margin: 0 0 var(--esp-3); }
  .lst-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: var(--esp-4); }
  .lst-paginas { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; margin: var(--esp-8) 0 0; }
  .lst-paginas a, .lst-paginas span { min-width: 44px; min-height: 44px; display: inline-flex; align-items: center; justify-content: center; padding: 0 12px; border: 1px solid var(--borde-card); border-radius: var(--radio-md); color: var(--color-texto-primario); text-decoration: none; }
  .lst-paginas a:hover { border-color: var(--color-marca); }
  .lst-paginas span[aria-current] { background: var(--color-marca); border-color: var(--color-marca); color: var(--color-texto-sobre-marca); font-weight: var(--peso-bold); }
  .lst-ver-todos { margin: var(--esp-6) 0 0; font-weight: var(--peso-bold); }
  .lst-ayuda { margin-top: var(--esp-12); padding: var(--esp-6); border: 1px dashed var(--color-borde-fuerte); border-radius: var(--radio-lg); }
  .lst-ayuda p { margin: 0 0 var(--esp-4); color: var(--color-texto-secundario); }
  .lst-ayuda strong { color: var(--color-texto-primario); }
  .lst-ayuda-acciones { display: flex; flex-wrap: wrap; gap: var(--esp-3); }
  .lst-btn { display: inline-flex; align-items: center; min-height: 48px; padding: 0 22px; border-radius: var(--radio-md); background: var(--color-marca); color: var(--color-texto-sobre-marca); font-family: var(--fuente-texto); font-size: var(--texto-cuerpo); font-weight: var(--peso-bold); border: 1px solid var(--color-marca); cursor: pointer; text-decoration: none; }
  .lst-btn:hover { text-decoration: none; background: var(--color-marca-hover); }
  .lst-btn-sec { background: transparent; color: var(--color-texto-primario); border-color: var(--color-borde-fuerte); }
  .lst-btn-sec:hover { background: transparent; border-color: var(--color-marca); }
  :global(.card-sku) { margin-top: 4px; font-size: var(--texto-xs); color: var(--color-texto-terciario); font-variant-numeric: tabular-nums; }
  :global(.card-precio-consultar) { font-size: var(--texto-cuerpo); font-weight: var(--peso-bold); }
</style>
