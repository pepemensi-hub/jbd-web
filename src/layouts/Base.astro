---
import negocio from '../data/negocio.json';
import SchemaLocalBusiness from '../components/SchemaLocalBusiness.astro';
import '../styles/tokens.css';
import Carrito from '../components/Carrito.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';

interface Props {
  titulo: string;
  descripcion: string;
}

const { titulo, descripcion } = Astro.props;
// En el sitio de prueba (QA) se compila con PUBLIC_ENTORNO=qa: no se indexa en Google.
const esQA = import.meta.env.PUBLIC_ENTORNO === 'qa';
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    {esQA && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:locale" content="es_AR" />
    <SchemaLocalBusiness />
  </head>
  <body>
    <slot />
    <Carrito />
    <WhatsAppFab />
  </body>
</html>