---
// Sección Taller JBD — Belén de Escobar (sucursal Estrada 835)
//
// ⚠️ DATOS A CONFIRMAR ANTES DE PUBLICAR:
//   - TALLER_HORARIOS: completar con los horarios reales del taller.
//   - TALLER_GEO lat/lng: aproximadas de Estrada 835. Verificar con la ubicación
//     exacta (botón "compartir" en Google Maps → coordenadas).

import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import negocio from '../../data/negocio.json';

// --- Datos del taller (única fuente de verdad de esta página) ---
const TALLER_DIRECCION = 'Estrada 835, Belén de Escobar';
const TALLER_HORARIOS = 'Lun a Sáb de 8:30 a 20:00 hs'; // ⚠️ confirmar si abre domingos

// Coordenadas aproximadas de Estrada 835, Belén de Escobar
const TALLER_GEO = { lat: -34.3489, lng: -58.7935 }; // ⚠️ verificar/ajustar con ubicación exacta en Maps

const msgTurno =
  'Hola JBD, quiero pedir un turno en el taller.\n' +
  'Vehículo: (marca / modelo / año)\n' +
  'Necesito: (qué le pasa al auto)';

const servicios = [
  {
    titulo: 'Service completo',
    texto: 'Aceite, filtros, correas y revisión punto por punto. Le hacemos el service que tu auto necesita para no dejarte a pie.',
  },
  {
    titulo: 'Frenos',
    texto: 'Pastillas, discos, cintas y purga del sistema. Frenar bien no es opcional: lo revisamos y te lo dejamos seguro.',
  },
  {
    titulo: 'Suspensión y dirección',
    texto: 'Amortiguadores, rótulas, extremos y alineación. Si tu auto tira para un lado o salta en cada pozo, lo resolvemos.',
  },
  {
    titulo: 'Diagnóstico de motor',
    texto: 'Escáner, distribución, embrague y puesta a punto. Detectamos la falla antes de que se transforme en un arreglo caro.',
  },
  {
    titulo: 'Electricidad e inyección',
    texto: 'Batería, alternador, sensores y limpieza de inyectores. Si se prendió una luz en el tablero, sabemos por qué.',
  },
  {
    titulo: 'Nafteros, diésel y utilitarios',
    texto: 'Atendemos autos, camionetas y utilitarios de cualquier marca. Vengas con lo que vengas, hay solución.',
  },
];

// --- Schema: AutoRepair anclado a la marca JBD (mismo negocio, otra dirección) ---
const schema = {
  '@context': 'https://schema.org',
  '@type': 'AutoRepair',
  '@id': 'https://jbdrespuestos.com/servicios/#taller',
  name: 'Taller JBD',
  image: 'https://jbdrespuestos.com/img/og-taller.jpg',
  url: 'https://jbdrespuestos.com/servicios/',
  telephone: `+${negocio.whatsapp}`,
  priceRange: '$$',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Estrada 835',
    addressLocality: 'Belén de Escobar',
    addressRegion: 'Buenos Aires',
    postalCode: 'B1625',
    addressCountry: 'AR',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: TALLER_GEO.lat,
    longitude: TALLER_GEO.lng,
  },
  // Relación con el negocio principal para no partir la autoridad de marca
  parentOrganization: {
    '@type': 'AutoPartsStore',
    '@id': 'https://jbdrespuestos.com/#negocio',
    name: negocio.nombre,
  },
  areaServed: negocio.zonas.map((z) => ({ '@type': 'City', name: z })),
};
---
<Base
  titulo={`Taller JBD — Mecánica en ${negocio.direccion.localidad}`}
  descripcion="El taller de JBD en Escobar. Service, frenos, suspensión, diagnóstico y más. Atendemos todo tipo de vehículos. Pedí turno por WhatsApp."
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <Header />
  <main class="taller">
    <div class="taller-hero">
      <p class="taller-kicker">SERVICIO MECÁNICO EN ESCOBAR</p>
      <h1 class="taller-titulo">El repuesto lo tenés. El <span class="rojo">taller</span> también.</h1>
      <p class="taller-bajada">
        Con más de 15 años de trayectoria en {negocio.direccion.localidad}, somos el taller de confianza
        de cientos de vecinos. A pocas cuadras del mostrador, atendemos todo tipo de vehículos: traé tu
        auto, dejalo en manos que saben, y salí andando.
      </p>
      <WhatsAppButton texto="Pedí turno por WhatsApp" mensaje={msgTurno} origen="taller" size="lg" />
    </div>

    <div class="taller-grid">
      {servicios.map(s => (
        <article class="taller-card">
          <h2>{s.titulo}</h2>
          <p>{s.texto}</p>
        </article>
      ))}
    </div>

    <div class="taller-confianza">
      <h2>¿Por qué dejar tu auto en JBD?</h2>
      <ul>
        <li>Repuesto y taller en un solo lugar. No hay ida y vuelta buscando la pieza.</li>
        <li>Atendemos todo tipo de vehículos, sin importar la marca ni el modelo.</li>
        <li>Presupuesto antes de tocar nada. Sabés lo que vas a pagar de entrada.</li>
      </ul>
      <WhatsAppButton texto="Escribinos y coordiná tu turno →" mensaje={msgTurno} origen="taller" size="lg" />
    </div>

    <div class="taller-datos">
      <p><strong>Dónde:</strong> {TALLER_DIRECCION}</p>
      <p><strong>Horarios:</strong> {TALLER_HORARIOS}</p>
    </div>
  </main>
  <Footer />
</Base>
<style>
  .taller { max-width: 1100px; margin: 0 auto; padding: var(--esp-16) var(--esp-4); }

  .taller-hero { text-align: center; margin-bottom: var(--esp-16); }
  .taller-kicker {
    font-family: var(--fuente-texto);
    font-weight: var(--peso-bold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    font-size: var(--texto-sm);
    color: var(--color-marca);
    margin: 0 0 var(--esp-3);
  }
  .taller-titulo {
    font-size: clamp(28px, 5vw, var(--texto-display));
    margin: 0 0 var(--esp-4);
  }
  .taller-titulo .rojo { color: var(--color-marca); }
  .taller-bajada {
    max-width: 620px;
    margin: 0 auto var(--esp-6);
    color: var(--color-texto-secundario);
    font-size: var(--texto-cuerpo-lg);
  }

  .taller-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--esp-4);
    margin-bottom: var(--esp-16);
  }
  .taller-card {
    border: var(--borde-fino);
    border-radius: var(--radio-lg);
    padding: var(--esp-6);
    background: var(--superficie-card);
    transition: border-color 0.15s ease;
  }
  .taller-card:hover { border-color: var(--color-marca); }
  .taller-card h2 { font-size: var(--texto-h3); margin: 0 0 var(--esp-2); }
  .taller-card p { color: var(--color-texto-secundario); margin: 0; }

  .taller-confianza {
    text-align: center;
    padding: var(--esp-10) var(--esp-4);
    border-radius: var(--radio-lg);
    background: var(--color-marca-tinte);
    border: 1px solid var(--color-marca-desat);
    margin-bottom: var(--esp-10);
  }
  .taller-confianza h2 { margin: 0 0 var(--esp-5); }
  .taller-confianza ul {
    list-style: none;
    padding: 0;
    max-width: 560px;
    margin: 0 auto var(--esp-6);
    display: grid;
    gap: var(--esp-3);
    text-align: left;
  }
  .taller-confianza li {
    padding-left: var(--esp-6);
    position: relative;
    color: var(--color-texto-secundario);
  }
  .taller-confianza li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--color-marca);
    font-weight: var(--peso-bold);
  }

  .taller-datos {
    text-align: center;
    color: var(--color-texto-secundario);
    line-height: var(--interlinea-cuerpo);
  }
  .taller-datos p { margin: 0 0 var(--esp-1); }
</style>
