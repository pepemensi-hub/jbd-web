---
import negocio from '../data/negocio.json';

const dias = {
  Mo: 'Lun', Tu: 'Mar', We: 'Mié', Th: 'Jue', Fr: 'Vie', Sa: 'Sáb', Su: 'Dom',
};
function rango(h) {
  const ds = h.dias.map(d => dias[d]);
  const etiqueta = ds.length > 1 ? `${ds[0]} a ${ds[ds.length - 1]}` : ds[0];
  return `${etiqueta}: ${h.abre} – ${h.cierra}`;
}
const anio = new Date().getFullYear();
---
<section class="google-banner" aria-label="JBD Repuestos en Google">
  <div class="gb-inner">
    <svg class="gb-logo" viewBox="0 0 24 24" width="56" height="56" aria-hidden="true">
      <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.27-4.74 3.27-8.1z"/>
      <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84A11 11 0 0 0 12 23z"/>
      <path fill="#FBBC05" d="M5.84 14.1A6.6 6.6 0 0 1 5.5 12c0-.73.13-1.44.34-2.1V7.06H2.18A11 11 0 0 0 1 12c0 1.78.43 3.45 1.18 4.94l3.66-2.84z"/>
      <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15A10.96 10.96 0 0 0 12 1 11 11 0 0 0 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
    </svg>
    <div class="gb-texto">
      <p class="gb-titulo">Encontranos en Google</p>
      <p class="gb-sub">
        <span class="gb-estrellas" aria-hidden="true">★★★★★</span>
        Mirá reseñas, fotos, horarios y cómo llegar. ¿Ya compraste en JBD? Contanos cómo te fue.
      </p>
    </div>
    <a class="gb-cta" href={negocio.google} target="_blank" rel="noopener">Dejanos tu reseña</a>
  </div>
</section>

<footer class="site-footer">
  <div class="footer-grid">
    <div class="footer-col">
      <span class="logo">
        <span class="logo-nombre">JBD<span class="logo-punto">.</span></span>
        <span class="logo-sub">Repuestos</span>
      </span>
      <p class="footer-desc">
        Casa de repuestos automotor en Belén de Escobar. Atendemos mostrador y WhatsApp.
      </p>
    </div>

    <div class="footer-col">
      <h4 class="footer-titulo">Dónde estamos</h4>
      <p class="footer-linea">{negocio.direccion.calle}</p>
      <p class="footer-linea">{negocio.direccion.localidad}, {negocio.direccion.provincia}</p>
      <p class="footer-linea">
        <a href={`tel:${negocio.telefono.replace(/\s/g, '')}`}>{negocio.telefono}</a>
      </p>
    </div>

    <div class="footer-col">
      <h4 class="footer-titulo">Horarios</h4>
      {negocio.horarios.map(h => <p class="footer-linea">{rango(h)}</p>)}
    </div>

    <div class="footer-col">
      <h4 class="footer-titulo">Zonas de entrega</h4>
      <p class="footer-linea footer-zonas">{negocio.zonas.join(' · ')}</p>
    </div>
  </div>

  <div class="footer-bottom">
    <span>© {anio} {negocio.razonSocial}. Todos los derechos reservados.</span>
    <span class="footer-credito">Website desarrollada por <a href="https://agencia1989.com.ar/" target="_blank" rel="noopener">Agencia 1989</a></span>
  </div>
</footer>

<style>
  /* Franja de Google a todo el ancho, pegada arriba del pie */
  .google-banner {
    margin-top: var(--esp-16);
    background: #FFFFFF;
    color: #1F1F1F;
    padding: var(--esp-10) var(--esp-4);
    border-top: 4px solid;
    border-image: linear-gradient(90deg, #4285F4 0 25%, #EA4335 25% 50%, #FBBC05 50% 75%, #34A853 75% 100%) 1;
  }
  .gb-inner {
    max-width: 1080px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: var(--esp-6);
  }
  .gb-logo { flex-shrink: 0; }
  .gb-texto { flex: 1; min-width: 0; }
  .gb-titulo {
    margin: 0 0 var(--esp-2);
    font-family: var(--fuente-display);
    font-size: var(--texto-h2, 28px);
    font-weight: var(--peso-black);
    line-height: 1.1;
    color: #1F1F1F;
  }
  .gb-sub { margin: 0; font-size: var(--texto-cuerpo); color: #444746; }
  .gb-estrellas { color: #FBBC05; letter-spacing: 2px; margin-right: 6px; }
  .gb-cta {
    flex-shrink: 0;
    display: inline-flex; align-items: center; justify-content: center;
    min-height: 52px; padding: 14px 28px;
    border-radius: var(--radio-md);
    background: var(--color-marca); color: var(--color-texto-sobre-marca);
    font-family: var(--fuente-texto); font-size: var(--texto-cuerpo-lg); font-weight: var(--peso-bold);
    text-decoration: none; transition: filter .12s;
  }
  .gb-cta:hover { filter: brightness(1.1); text-decoration: none; }
  @media (max-width: 760px) {
    .gb-inner { flex-direction: column; text-align: center; gap: var(--esp-4); }
    .gb-cta { width: 100%; }
  }

  .site-footer {
    background: var(--superficie-card);
    border-top: 1px solid var(--borde-card);
    padding: var(--esp-12) var(--esp-4) var(--esp-6);
  }
  .footer-grid {
    max-width: 1080px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: var(--esp-8);
  }
  .logo {
    display: inline-flex;
    align-items: baseline;
    gap: 7px;
    font-family: var(--fuente-display);
    line-height: 1;
  }
  .logo-nombre {
    font-size: 24px;
    font-weight: var(--peso-black);
    letter-spacing: -0.02em;
    color: var(--color-texto-primario);
  }
  .logo-punto { color: var(--color-marca); }
  .logo-sub {
    font-size: 10px;
    font-weight: var(--peso-bold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-texto-secundario);
  }
  .footer-desc {
    margin-top: var(--esp-3);
    color: var(--color-texto-secundario);
    font-size: var(--texto-sm);
    max-width: 32ch;
  }
  .footer-titulo {
    font-family: var(--fuente-texto);
    font-size: var(--texto-xs);
    font-weight: var(--peso-bold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--color-texto-terciario);
    margin: 0 0 var(--esp-3);
  }
  .footer-linea {
    margin: 0 0 var(--esp-2);
    font-size: var(--texto-sm);
    color: var(--color-texto-secundario);
  }
  .footer-linea a { color: var(--color-texto-secundario); }
  .footer-linea a:hover { color: var(--color-marca-texto); }
  .footer-zonas { line-height: 1.7; }
  .footer-bottom {
    max-width: 1080px;
    margin: var(--esp-8) auto 0;
    padding-top: var(--esp-5);
    border-top: 1px solid var(--borde-card);
    font-size: var(--texto-xs);
    color: var(--color-texto-terciario);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--esp-2) var(--esp-6);
    padding-bottom: 72px; /* que el botón flotante de WhatsApp no tape el crédito */
  }
  .footer-credito { font-size: calc(var(--texto-xs) * 2); }
  .footer-bottom a { color: var(--color-texto-secundario); text-decoration: underline; }
  .footer-bottom a:hover { color: var(--color-marca-texto); }

  @media (max-width: 760px) {
    .footer-grid { grid-template-columns: 1fr 1fr; gap: var(--esp-6); }
  }
  @media (max-width: 440px) {
    .footer-grid { grid-template-columns: 1fr; }
  }
</style>