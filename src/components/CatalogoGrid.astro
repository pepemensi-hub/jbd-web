---
// Los productos (~37.000 con foto) se cargan desde /catalogo.json y se dibujan en el cliente
// de a tandas; las tarjetas replican el markup de ProductCard.astro (sus estilos son globales).
import ProductCard from './ProductCard.astro';
import StockBadge from './StockBadge.astro';
import stock from '../data/stock.json';
import negocio from '../data/negocio.json';

const productos = stock.productos;
const urlDatos = import.meta.env.BASE_URL.replace(/\/?$/, '/') + 'catalogo.json';
const marcas = [...new Set(productos.map(p => p.marca))].sort();
const categorias = [
  { id: 'filtros', label: 'Filtros' },
  { id: 'correas', label: 'Correas' },
  { id: 'frenos', label: 'Frenos' },
  { id: 'encendido', label: 'Encendido' },
  { id: 'suspension', label: 'Suspensión' },
  { id: 'refrigeracion', label: 'Refrigeración' },
  { id: 'electricidad', label: 'Electricidad' },
  { id: 'inyeccion', label: 'Inyección' },
  { id: 'transmision', label: 'Transmisión' },
  { id: 'direccion', label: 'Dirección' },
  { id: 'escape', label: 'Escape' },
  { id: 'aire-acondicionado', label: 'Aire acondicionado' },
  { id: 'tren-delantero', label: 'Tren delantero' },
  { id: 'motor', label: 'Motor' },
  { id: 'carroceria', label: 'Carrocería y accesorios' },
  { id: 'otros', label: 'Otros' },
];
const catConProductos = categorias.filter(c => productos.some(p => p.categoria === c.id));
---
<div class="cat-buscador">
  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
  <input type="search" id="q" placeholder="Buscar por nombre, marca, modelo o código…" autocomplete="off" />
</div>

<div class="cat-layout">
  <aside class="cat-filtros">
    <div class="filtro-grupo">
      <h4>Categoría</h4>
      <div class="chips" data-filtro="categoria">
        <button class="chip activo" data-val="">Todas</button>
        {catConProductos.map(c => <button class="chip" data-val={c.id}>{c.label}</button>)}
      </div>
    </div>
    <div class="filtro-grupo">
      <h4>Marca</h4>
      <div class="chips" data-filtro="marca">
        <button class="chip activo" data-val="">Todas</button>
        {marcas.map(m => <button class="chip" data-val={m}>{m}</button>)}
      </div>
    </div>
    <div class="filtro-grupo">
      <h4>Disponibilidad</h4>
      <div class="chips" data-filtro="estado">
        <button class="chip activo" data-val="">Todas</button>
        <button class="chip" data-val="disponible">En stock</button>
        <button class="chip" data-val="pedido">A pedido</button>
      </div>
    </div>
  </aside>

  <div class="cat-resultados">
    <div class="cat-contador"><span id="contador">{productos.length}</span> resultados</div>
    <div class="cat-grid" id="grid" data-url={urlDatos} data-wa={negocio.whatsapp}>
      {productos.slice(0, 24).map(p => (
        <div class="grid-item">
          <ProductCard sku={p.sku} nombre={p.nombre} marca={p.marca} modelos={p.modelos} precio={p.precio} estado={p.estado} imagen={p.imagen} />
        </div>
      ))}
    </div>
    <div class="cat-mas">
      <button type="button" class="cat-mas-btn" id="ver-mas" hidden>Ver más repuestos</button>
    </div>
    <template id="tpl-badges">
      <StockBadge estado="disponible" />
      <StockBadge estado="pedido" />
      <StockBadge estado="agotado" />
    </template>
    <div class="cat-vacio" id="vacio" hidden>
      <p>No encontramos repuestos con esos filtros.</p>
      <p class="cat-vacio-sub">Probá con otra búsqueda o consultanos directamente.</p>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    const POR_TANDA = 48;
    const IMG = 'https://lh3.googleusercontent.com/d/';

    const estado = { categoria: '', marca: '', estado: '', q: '' };
    const grid = document.getElementById('grid');
    const contador = document.getElementById('contador');
    const vacio = document.getElementById('vacio');
    const input = document.getElementById('q');
    const verMas = document.getElementById('ver-mas');
    const whatsapp = grid.dataset.wa;

    // Badges (del template) e ícono de WhatsApp (de la primera tarjeta que renderizó Astro),
    // para no duplicar su markup acá.
    const badges = {};
    document.getElementById('tpl-badges').content.querySelectorAll('.badge').forEach(function (b, i) {
      badges[['disponible', 'pedido', 'agotado'][i]] = b.outerHTML;
    });
    const primeraCta = grid.querySelector('.card-cta');
    const iconoWA = primeraCta ? primeraCta.innerHTML : 'WhatsApp';

    let todos = null; // [{ sku, nombre, marca, fab, cat, est, img, buscar }]
    let filtrados = [];
    let mostrados = 0;

    const MAPA_ESC = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
    const esc = function (s) { return String(s).replace(/[&<>"']/g, function (c) { return MAPA_ESC[c]; }); };
    const sinAcentos = function (s) { return s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase(); };

    function linkWA(p) {
      const texto = 'Hola JBD, quiero consultar por: ' + p.nombre + ' (cód. ' + p.sku + ')';
      return 'https://wa.me/' + whatsapp + '?text=' + encodeURIComponent(texto);
    }

    function tarjeta(p) {
      const agotado = p.est === 'agotado';
      const img = p.img
        ? '<img src="' + IMG + esc(p.img) + '=w400" alt="' + esc(p.nombre) + '" loading="lazy" decoding="async" width="400" height="300" referrerpolicy="no-referrer">'
        : '';
      return '<div class="grid-item"><article class="' + (agotado ? 'card agotado' : 'card') + '">' +
        '<div class="card-img">' + img + '</div>' +
        '<div class="card-body">' +
          '<div class="card-top">' + (badges[p.est] || badges.disponible) + '</div>' +
          '<div><div class="card-marca">' + esc(p.marca) + (p.fab ? ' · ' + esc(p.fab) : '') + '</div>' +
          '<h3 class="card-nombre">' + esc(p.nombre) + '</h3></div>' +
          '<div class="card-precio">Consultar</div>' +
          '<div class="card-acciones">' +
            '<button class="card-agregar" data-agregar data-sku="' + esc(p.sku) + '" data-nombre="' + esc(p.nombre) + '" data-compat="' + esc(p.marca) + '" data-precio=""' + (agotado ? ' hidden' : '') + '>Agregar</button>' +
            '<a class="card-cta" href="' + esc(linkWA(p)) + '" target="_blank" rel="noopener noreferrer" data-wa="catalogo" data-sku="' + esc(p.sku) + '" aria-label="Consultar por WhatsApp">' + iconoWA + '</a>' +
          '</div>' +
        '</div></article></div>';
    }

    function dibujarTanda() {
      const tanda = filtrados.slice(mostrados, mostrados + POR_TANDA);
      grid.insertAdjacentHTML('beforeend', tanda.map(tarjeta).join(''));
      mostrados += tanda.length;
      verMas.hidden = mostrados >= filtrados.length;
    }

    function aplicar() {
      if (!todos) return;
      const palabras = sinAcentos(estado.q).split(/\s+/).filter(Boolean);
      filtrados = todos.filter(function (p) {
        if (estado.categoria && p.cat !== estado.categoria) return false;
        if (estado.marca && p.marca !== estado.marca) return false;
        if (estado.estado && p.est !== estado.estado) return false;
        for (let i = 0; i < palabras.length; i++) if (p.buscar.indexOf(palabras[i]) === -1) return false;
        return true;
      });
      grid.innerHTML = '';
      mostrados = 0;
      dibujarTanda();
      contador.textContent = filtrados.length.toLocaleString('es-AR');
      vacio.hidden = filtrados.length !== 0;
      grid.hidden = filtrados.length === 0;
    }

    document.querySelectorAll('.chips').forEach(function (grupo) {
      const tipo = grupo.dataset.filtro;
      grupo.addEventListener('click', function (e) {
        const chip = e.target.closest('.chip');
        if (!chip) return;
        grupo.querySelectorAll('.chip').forEach(c => c.classList.remove('activo'));
        chip.classList.add('activo');
        estado[tipo] = chip.dataset.val;
        aplicar();
      });
    });

    let t;
    input.addEventListener('input', function () {
      clearTimeout(t);
      t = setTimeout(function () {
        estado.q = input.value.trim();
        aplicar();
      }, 150);
    });

    verMas.addEventListener('click', dibujarTanda);

    const qInit = new URLSearchParams(location.search).get('q');
    if (qInit) {
      input.value = qInit;
      estado.q = qInit.trim();
    }

    fetch(grid.dataset.url)
      .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
      .then(function (datos) {
        todos = datos.productos.map(function (a) {
          return {
            sku: a[0], nombre: a[1], marca: a[2], fab: a[3], cat: a[4], est: a[5], img: a[6],
            buscar: sinAcentos(a[1] + ' ' + a[2] + ' ' + a[3] + ' ' + a[0] + ' ' + a[0].replace(/[^a-z0-9]/gi, '')),
          };
        });
        aplicar();
      })
      .catch(function (err) { console.error('No se pudo cargar el catálogo', err); });
  })();
</script>

<style>
  .cat-buscador { display: flex; align-items: center; gap: 10px; background: var(--superficie-input); border: 1px solid var(--color-borde-fuerte); border-radius: var(--radio-md); padding: 0 14px; min-height: 52px; margin-bottom: var(--esp-6); color: var(--color-texto-terciario); }
  .cat-buscador input { flex: 1; border: 0; outline: 0; background: transparent; font-family: var(--fuente-texto); font-size: var(--texto-cuerpo-lg); color: var(--color-texto-primario); min-width: 0; }
  .cat-layout { display: grid; grid-template-columns: 240px 1fr; gap: var(--esp-8); align-items: start; }
  .cat-filtros { position: sticky; top: var(--esp-4); display: flex; flex-direction: column; gap: var(--esp-6); }
  .filtro-grupo h4 { font-family: var(--fuente-texto); font-size: var(--texto-xs); font-weight: var(--peso-bold); text-transform: uppercase; letter-spacing: var(--tracking-label); color: var(--color-texto-terciario); margin: 0 0 var(--esp-3); }
  .chips { display: flex; flex-wrap: wrap; gap: var(--esp-2); }
  .chip { font-family: var(--fuente-texto); font-size: var(--texto-sm); font-weight: var(--peso-medio); padding: 7px 14px; border-radius: var(--radio-pill); border: 1px solid var(--color-borde-fuerte); background: transparent; color: var(--color-texto-secundario); cursor: pointer; transition: all .12s; }
  .chip:hover { border-color: var(--color-marca); color: var(--color-texto-primario); }
  .chip.activo { background: var(--color-marca); border-color: var(--color-marca); color: var(--color-texto-sobre-marca); }
  .cat-contador { font-size: var(--texto-sm); color: var(--color-texto-secundario); margin-bottom: var(--esp-4); }
  .cat-mas { display: flex; justify-content: center; margin-top: var(--esp-8); }
  .cat-mas-btn { font-family: var(--fuente-texto); font-size: var(--texto-cuerpo); font-weight: var(--peso-semibold); min-height: 48px; padding: 12px 28px; border-radius: var(--radio-md); border: 1px solid var(--color-borde-fuerte); background: transparent; color: var(--color-texto-primario); cursor: pointer; }
  .cat-mas-btn:hover { border-color: var(--color-marca); }
  .cat-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--esp-5); }
  .cat-vacio { text-align: center; padding: var(--esp-16) var(--esp-4); }
  .cat-vacio-sub { color: var(--color-texto-secundario); font-size: var(--texto-sm); }
  @media (max-width: 980px) { .cat-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 820px) { .cat-layout { grid-template-columns: 1fr; } .cat-filtros { position: static; } }
  @media (max-width: 520px) { .cat-grid { grid-template-columns: 1fr; } }
</style>